{
  "name": "Fastify Minimal Project",
  "version": "1.0.0",
  "description": "this project is minimal setup for fastify",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && tsc-alias",
    "start": "npm run build && node ./dist/index.js",
    "dev:run": "tsc-alias && node --enable-source-maps ./dist/index.js",
    "dev": "tsc-watch -b --verbose --onSuccess \"npm run dev:run\"",
    "test": "npm run build && node --enable-source-maps --test dist/**/*.test.js",
    "migrate": "npm run build && node --enable-source-maps --env-file=.env.migrate ./dist/index.js",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.9",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.5.14",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/env": "^5.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^9.1.3",
    "@fastify/type-provider-typebox": "^6.0.0",
    "fastify": "^5.3.2",
    "mongoose": "^9.6.1",
    "prompts": "^2.4.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "typebox": "^1.1.37",
    "ws": "^8.18.0"
  }
}