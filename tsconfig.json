{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "paths": {
      "@src/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}